nType":"component","Skin":{"brandingId":"*6377849726","templateId":"*simple","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"DE":[]},"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days"}},{"SurveyID":"SV_d6DHlyIqCPLIRSe","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"\u00dcbungsbeispiel: Diese Bewertung dient nur zum Kennenlernen und wird nicht ausgewertet. Kundenanfr..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>\u00dcbungsbeispiel:<\/strong> Diese Bewertung dient nur zum Kennenlernen und wird nicht ausgewertet.<\/p>\n<p><strong>Kundenanfrage<\/strong><\/p>\n<p>Hi, ich hab vor ein paar Monaten einen Schrank bestellt, wohn aber in der Schweiz. Gilt die gesetzliche Gew\u00e4hrleistung da auch oder nur in Deutschland? Danke und LG, Fabienne<\/p>\n<p><strong>Antwortentwurf<\/strong><\/p>\n<p>Guten Tag,<\/p><p>vielen Dank f\u00fcr Ihre Nachricht. Die gesetzliche Gew\u00e4hrleistung gilt auch f\u00fcr Kundinnen und Kunden in der Schweiz, denn sie gilt einheitlich in allen M\u00e4rkten \u2013 also in Deutschland, \u00d6sterreich und der Schweiz gleicherma\u00dfen. Die Gew\u00e4hrleistung betr\u00e4gt 2 Jahre ab Lieferung Ihres Schrankes.<\/p><p>Sollten Sie einen Mangel an Ihrem Schrank feststellen, kontaktieren Sie uns gerne \u00fcber Kontaktformular, E-Mail, Live-Chat oder Telefon, beschreiben Sie den Mangel kurz und halten Sie Ihre Bestellnummer bereit. Wir besprechen dann mit Ihnen das weitere Vorgehen.<\/p><p>Viele Gr\u00fc\u00dfe, Ihr Hallendal-Wohnen-Team<\/p>","DefaultChoices":false,"DataExportTag":"UE_Text","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00dcbungsbeispiel: Diese Bewertung dient nur zum Kennenlernen und wird nicht ausgewertet. Kundenanfr...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_d6DHlyIqCPLIRSe","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Wie fachlich korrekt wirkt diese Antwort auf Sie?","TertiaryAttribute":null,"Payload":{"QuestionText":"Wie fachlich korrekt wirkt diese Antwort auf Sie?","DefaultChoices":false,"DataExportTag":"UE_Q1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Wie fachlich korrekt wirkt diese Antwort auf Sie?","Choices":{"1":{"Display":"wirkt falsch"},"2":{"Display":"wirkt teilweise korrekt (im Kern richtig, aber mit Ungenauigkeiten)"},"3":{"Display":"wirkt korrekt"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID11","RecodeValues":{"1":"1","2":"2","3":"3"}}},{"SurveyID":"SV_d6DH